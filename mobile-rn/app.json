{
  "expo": {
    "name": "WORK WATCH BLE",
    "slug": "workwatch-ble-map-rn",
    "scheme": "workwatch-ble",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.workwatch.blemap"
    },
    "android": {
      "package": "com.workwatch.blemap",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0f1419",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": ["central"],
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Bluetooth для сканирования BLE-меток WORK WATCH"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Карта объектов WORK WATCH"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "workwatch-ble-map-rn-local"
      }
    }
  }
}
